/**
 * LanguageSelector.jsx
 * Language selection component with search functionality
 */
import React, { useState, useContext, useMemo } from 'react';
import { ReferenceContext } from '../../../context/ReferenceContext';
import { useLanguages } from '../../../hooks/useLanguages';
import { useOrganizations } from '../../../hooks/useOrganizations';
import styles from './LanguageSelector.module.css';

export function LanguageSelector({ onSelect, onBack, slideDirection }) {
  const { organization } = useContext(ReferenceContext);
  const { organizations } = useOrganizations();
  const [searchTerm, setSearchTerm] = useState('');

  // Get languages from unfoldingWord (primary source for all languages)
  const { languages: unfoldingWordLanguages } = useLanguages('unfoldingWord');
  
  // Get languages from current organization as fallback
  const { languages: currentOrgLanguages } = useLanguages(organization);
  
  const allLanguages = useMemo(() => {
    // Primary: Use unfoldingWord languages (they have the most comprehensive list)
    if (unfoldingWordLanguages && unfoldingWordLanguages.length > 0) {
      return unfoldingWordLanguages.map(lang => ({
        code: lang.code,
        name: lang.name,
        organizations: ['unfoldingWord']
      })).sort((a, b) => a.name.localeCompare(b.name));
    }
    
    // Fallback: Use current organization languages
    if (currentOrgLanguages && currentOrgLanguages.length > 0) {
      return currentOrgLanguages.map(lang => ({
        code: lang.code,
        name: lang.name,
        organizations: [organization || 'Current']
      })).sort((a, b) => a.name.localeCompare(b.name));
    }
    
    return [];
  }, [unfoldingWordLanguages, currentOrgLanguages, organization]);

  const filteredLanguages = useMemo(() => {
    if (!searchTerm.trim()) return allLanguages;
    
    const term = searchTerm.toLowerCase();
    return allLanguages.filter(lang => 
      lang.name.toLowerCase().includes(term) ||
      lang.code.toLowerCase().includes(term)
    );
  }, [allLanguages, searchTerm]);

  const handleLanguageSelect = (language) => {
    onSelect(language.code);
  };

  return (
    <div className={styles.selectorContainer}>
      {/* Header */}
      <div className={styles.header}>
        <button onClick={onBack} className={styles.backButton}>
          ← Back
        </button>
        <h3 className={styles.title}>Select Language</h3>
        <div className={styles.spacer} />
      </div>

      {/* Search */}
      <div className={styles.searchContainer}>
        <input
          type="text"
          placeholder="Search languages..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className={styles.searchInput}
          autoFocus
        />
      </div>

      {/* Language List */}
      <div className={styles.listContainer}>
        {filteredLanguages.length > 0 ? (
          filteredLanguages.map(language => (
            <button
              key={language.code}
              onClick={() => handleLanguageSelect(language)}
              className={styles.languageItem}
            >
              <div className={styles.languageInfo}>
                <div className={styles.languageName}>{language.name}</div>
                <div className={styles.languageCode}>{language.code.toUpperCase()}</div>
              </div>
                             <div className={styles.organizationCount}>
                 {language.organizations.join(', ')}
               </div>
            </button>
          ))
        ) : (
          <div className={styles.emptyState}>
            {searchTerm ? 'No languages found' : 'Loading languages...'}
          </div>
        )}
      </div>
    </div>
  );
}
